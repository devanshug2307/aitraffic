# Read only by `aitraffic auth google configure --from-env-file PATH`.
# Values are copied into the operating-system credential store, never project config.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# MCP log analysis is restricted to the current project by default.
# Set this only in a trusted local environment.
AITRAFFIC_ALLOW_OUTSIDE_PROJECT=0
